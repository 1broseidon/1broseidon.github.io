{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chain-sh",
  "compatibility_date": "2026-09-15",

  // Pure static assets — no Worker script. Sub-path forwarding lives in
  // dist/_redirects, which Workers serves natively.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  }
}
